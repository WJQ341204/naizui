# Novel2Vid 环境变量配置
# 复制此文件为 .env 并填写你的密钥（.env 已在 .gitignore 中，不会提交）

# ─── 必填：AI 分镜 ───
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-key-here

# ─── ComfyUI ───
# ComfyUI 连接地址（默认本地）
COMFYUI_URL=http://127.0.0.1:8188
# 模型目录（留空时自动探测，本机示例 D:/ComfyUI/models）
COMFYUI_MODELS_DIR=
# ComfyUI 根目录（用于定位自带 ffmpeg，可选）
COMFYUI_PATH=

# ─── 配音引擎（v12.3：阶跃星辰 StepFun）───
# 申请：https://platform.stepfun.com → API Keys
# 填写后阶跃星辰自动成为默认配音引擎；失败自动回退 Edge，出片不中断
STEPFUN_API_KEY=
# ⚠️ Step Plan 订阅 Key 必须填 https://api.stepfun.com/step_plan/v1
#    按量计费 Key 请留空（自动走标准端点 https://api.stepfun.com/v1）
STEPFUN_BASE_URL=
# 模型：stepaudio-2.5-tts（旗舰，支持情绪指导）| step-tts-2 | step-tts-mini（轻量，不支持情绪指导）
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
# 强制指定引擎：stepfun | cosyvoice | edge，留空则自动（stepfun > cosyvoice > edge）
TTS_ENGINE=

# ── v12.4 新增开关 ──────────────────────────────
# TTS 缓存：1=启用（默认），0=关闭。启用后同一「文本+音色+情绪+语速」复用已生成音频，不重复消耗云端额度
TTS_CACHE=1
# 严格视频模式：0=默认，1=开启。开启后真视频引擎失败时拒绝降级为 ken_burns（静态图+推拉），宁可报错
STRICT_VIDEO_MODE=0

# ─── Docker 部署（docker-compose.yml 读取，不参与本机 venv 运行）───
# 权重目录在宿主机上的位置。默认 ./models；本机权重放在项目外面时用 ../models
MODEL_DIR=./models
# ComfyUI 镜像（仅 --profile gpu 用到）；留空则用 comfyanonymous/comfyui:latest
COMFYUI_IMAGE=
# HF 下载镜像。国内填 https://hf-mirror.com，装权重时省一大截时间
HF_ENDPOINT=https://hf-mirror.com

# ─── MiniMax-H3（需 GPU，本机无 N 卡时 --engine h3 会自动降级）───
COMFYUI_URL=http://127.0.0.1:8188
H3_UNET_NAME=minimax_h3_fl2va_pruned_fp8_scaled.safetensors
H3_CLIP_NAME=qwen3vl_32b_nvfp4_awq.safetensors
H3_VAE_NAME=minimax_h3_video_vae_int8_convrot.safetensors
H3_AUDIO_VAE_NAME=minimax_h3_audio_vae_fp32.safetensors
H3_STEPS=4
H3_WIDTH=768
H3_HEIGHT=1344
