# ── 密钥 / 环境变量（绝不提交）──
.env
.env.local
*.secret
launcher_config.json
# 本地 Gemini / 各类 API key 快照，极易误提交
*.json.key
*_key.json
# GitHub 上传仓库用的 Personal Access Token（repo 权限），绝不入库
.github_token

# ── 日志 ──
*.log
*.out
_logs/

# ── Python ──
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# ── Node.js ──
node_modules/
web/node_modules/

# ── 构建产物 ──
build/
dist/
*.spec.bak

# ── 运行时产物（story2 管线）──
